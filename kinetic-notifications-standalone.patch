+/** When each word of a line is sung and stops being sung, and where it sits in the line's text. */
+private class Spans(val starts: LongArray, val ends: LongArray, val ranges: List<IntRange>)
+
+/**
+ * The words of [line] with the moment each is sung: the source's own timing
+ * where it has it, otherwise the line's time shared out by word length, over
+ * the first four fifths of the time before the next line.
+ */
+private fun spansOf(line: LyricLine, endMs: Long?): Spans {
+    if (line.words.isNotEmpty()) {
+        var cursor = 0
+        val found = ArrayList<IntRange>(line.words.size)
+        for (word in line.words) {
+            val at = line.text.indexOf(word.text, cursor)
+            if (at < 0) break
+            found.add(at until at + word.text.length)
+            cursor = at + word.text.length
+        }
+        if (found.size == line.words.size) {
+            return Spans(
+                LongArray(line.words.size) { line.words[it].startMs },
+                LongArray(line.words.size) { line.words[it].endMs },
+                found,
+            )
+        }
+    }
+    val spans = Regex("\\S+").findAll(line.text).map { it.range }.toList()
+    val start = line.startTimeMs ?: 0L
+    val room = ((endMs ?: (start + 4000L)) - start).coerceIn(600L, 6000L)
+    val singing = room * 4 / 5
+    val total = spans.sumOf { it.last - it.first + 2 }.coerceAtLeast(1)
+    var used = 0
+    val starts = LongArray(spans.size) { i ->
+        val at = start + singing * used / total
+        used += spans[i].last - spans[i].first + 2
+        at
+    }
+    val ends = LongArray(spans.size) { i ->
+        if (i < spans.lastIndex) starts[i + 1] else start + singing
+    }
+    return Spans(starts, ends, spans)
+}
+
+/**
+ * A clock that runs on the screen's own frames. The song's position is only
+ * reported every so often; this carries on from the last report frame by
+ * frame so the words move smoothly, follows the reports so it never drifts,
+ * and runs on for only a third of a second after one, so a paused song stops
+ * asking the screen for frames.
+ */
+@Composable
+private fun rememberKineticClock(positionMs: State<Long>): State<Long> {
+    val smooth = remember { mutableStateOf(0L) }
+    LaunchedEffect(Unit) {
+        var anchor = positionMs.value
+        var anchorAt = System.nanoTime()
+        smooth.value = anchor
+        snapshotFlow { positionMs.value }.collectLatest { reported ->
+            val now = System.nanoTime()
+            val expected = anchor + (now - anchorAt) / 1_000_000L
+            anchor = reported
+            anchorAt = now
+            if (abs(reported - expected) > 600L) smooth.value = reported
+            val until = now + 350_000_000L
+            while (true) {
+                val frame = withFrameNanos { System.nanoTime() }
+                if (frame > until) break
+                val ahead = ((frame - anchorAt) / 1_000_000L).coerceAtMost(300L)
+                smooth.value = maxOf(smooth.value, anchor + ahead)
+            }
+        }
+    }
+    return smooth
+}
+
+/** Every word of the song, in the order it is sung, with when it starts and when it is done. */
+private class SungWords(val starts: LongArray, val ends: LongArray, val texts: Array<String>)
+
+private fun sungWordsOf(lyrics: Lyrics): SungWords {
+    val starts = ArrayList<Long>()
+    val ends = ArrayList<Long>()
+    val texts = ArrayList<String>()
+    val lines = lyrics.lines
+    for (i in lines.indices) {
+        val line = lines[i]
+        if (line.text.isBlank()) continue
+        val reveal = spansOf(line, lines.getOrNull(i + 1)?.startTimeMs)
+        for (w in reveal.starts.indices) {
+            val range = reveal.ranges[w]
+            if (range.first < 0 || range.last >= line.text.length) continue
+            val text = line.text.substring(range.first, range.last + 1)
+            if (text.isBlank()) continue
+            // Never before the word that came first, so the order can be searched.
+            val start = maxOf(reveal.starts[w], starts.lastOrNull() ?: Long.MIN_VALUE)
+            starts.add(start)
+            ends.add(maxOf(reveal.ends[w], start))
+            texts.add(text)
+        }
+    }
+    return SungWords(starts.toLongArray(), ends.toLongArray(), texts.toTypedArray())
+}
+
+/** The last word that has started by [pos], or -1. */
+private fun wordAt(starts: LongArray, pos: Long): Int {
+    var low = 0
+    var high = starts.size - 1
+    var found = -1
+    while (low <= high) {
+        val mid = (low + high) ushr 1
+        if (starts[mid] <= pos) {
+            found = mid
+            low = mid + 1
+        } else {
+            high = mid - 1
+        }
+    }
+    return found
+}
+
+private fun mixF(from: Float, to: Float, fraction: Float): Float = from + (to - from) * fraction
+
+/** Rises to 1 and goes a little past it before settling. */
+private fun outBack(x: Float): Float {
+    val c = x.coerceIn(0f, 1f) - 1f
+    return 1f + 2.2f * c * c * c + 1.2f * c * c
+}
+
+/**
+ * The lyrics one word at a time, as a column of three.
+ *
+ * The word being sung is large and bold in the middle, with a small picture
+ * beside it where the word has one (a heart for "heart", a car for "car").
+ * The word just sung stays above it, small; the word coming up waits below,
+ * smaller still and tinted. When the next word is sung the whole column
+ * climbs a place with a little spring and a smear of motion: the word just
+ * sung goes up and small, the next grows into the middle, and a new one
+ * comes up below.
+ *
+ * Lyrics that are not synced have no "now" for the column to follow, so they
+ * are shown plainly, as in the classic view.
+ */
+@Composable
+fun KineticLyricsView(
+    lyrics: Lyrics,
+    positionMs: State<Long>,
+    modifier: Modifier = Modifier,
+    showTranslation: Boolean = false,
+    onSeek: (Long) -> Unit,
+) {
+    if (!lyrics.synced) {
+        ClassicLyricsView(
+            lyrics = lyrics,
+            positionMs = positionMs,
+            modifier = modifier,
+            showTranslation = showTranslation,
+            onSeek = onSeek,
+        )
+    } else {
+        KineticColumn(lyrics, positionMs, modifier)
+    }
+}
+
+@Composable
+private fun KineticColumn(
+    lyrics: Lyrics,
+    positionMs: State<Long>,
+    modifier: Modifier,
+) {
+    val ink = GlassInk
+    val measurer = rememberTextMeasurer()
+    val clock = rememberKineticClock(positionMs)
+    val words = remember(lyrics) { sungWordsOf(lyrics) }
+    val bigStyle = MaterialTheme.typography.headlineLarge.copy(
+        fontSize = BIG_SP.sp,
+        fontWeight = FontWeight.ExtraBold,
+        letterSpacing = (-1).sp,
+    )
+    val iconStyle = TextStyle(fontSize = (BIG_SP * 0.72f).sp)
+    // Each word measured once, the first time it is wanted, and kept while
+    // it is near; the maps are emptied now and then so a long song does not
+    // keep every word it has ever sung.
+    val layouts = remember(lyrics) { HashMap<Int, TextLayoutResult>() }
+    val iconLayouts = remember(lyrics) { HashMap<String, TextLayoutResult>() }
+
+    Canvas(modifier.fillMaxSize()) {
+        val count = words.texts.size
+        if (count == 0) return@Canvas
+        val pos = clock.value
+        val now = wordAt(words.starts, pos)
+        if (now < 0) return@Canvas
+        if (layouts.size > 48) layouts.clear()
+
+        // A long gap with nothing sung lets the words go.
+        val idle = (pos - words.ends[now] - IDLE_AFTER_MS).toFloat()
+        val overall = (1f - idle / IDLE_FADE_MS).coerceIn(0f, 1f)
+        if (overall <= 0f) return@Canvas
+
+        // The round buttons down the right of the screen keep to their own strip.
+        val left = 24.dp.toPx()
+        val right = size.width - 64.dp.toPx()
+        val centreX = (left + right) / 2f
+        val centreY = size.height * 0.46f
+        val roomWidth = right - left
+
+        // How far the column still has to climb to the word being sung.
+        val before = if (now > 0) words.starts[now - 1] else words.starts[now] - CLIMB_MAX_MS
+        val climbMs = (words.starts[now] - before).coerceIn(CLIMB_MIN_MS, CLIMB_MAX_MS).toFloat()
+        val progress = ((pos - words.starts[now]) / climbMs).coerceIn(0f, 1f)
+        val shift = 1f - outBack(progress)
+        // The smear peaks halfway through the climb.
+        val smear = sin(PI.toFloat() * progress)
+
+        val bigHeight = BIG_SP.sp.toPx()
+        val gap = 6.dp.toPx()
+        val nearStep = bigHeight * (0.5f + 0.5f * NEAR_SCALE) + gap
+        val farStep = bigHeight * (0.5f * NEAR_SCALE + 0.5f * FAR_SCALE) + gap
+
+        fun scaleAt(place: Float): Float {
+            val a = abs(place)
+            return when {
+                a < 1f -> mixF(1f, NEAR_SCALE, a)
+                a < 2f -> mixF(NEAR_SCALE, FAR_SCALE, a - 1f)
+                else -> FAR_SCALE
+            }
+        }
+
+        fun yAt(place: Float): Float {
+            val a = abs(place)
+            val step = if (a <= 1f) a * nearStep else nearStep + (a - 1f).coerceAtMost(1f) * farStep
+            return centreY + place.sign * step
+        }
+
+        fun alphaAt(place: Float): Float {
+            val a = abs(place)
+            val near = if (place > 0f) 0.6f else 0.65f
+            return if (a <= 1f) mixF(1f, near, a) else mixF(near, 0f, (a - 1f).coerceIn(0f, 1f))
+        }
+
+        // Farthest first, so the word being sung is drawn over the rest.
+        for (index in intArrayOf(now - 2, now + 2, now - 1, now + 1, now)) {
+            if (index < 0 || index >= count) continue
+            val place = (index - now) + shift
+            val alpha = alphaAt(place) * overall
+            if (alpha <= 0.01f) continue
+
+            val text = words.texts[index]
+            val layout = layouts.getOrPut(index) { measurer.measure(text, bigStyle) }
+            val icon = iconFor(text)
+            val iconLayout = icon?.let { iconLayouts.getOrPut(it) { measurer.measure(it, iconStyle) } }
+            val iconSpace = if (iconLayout != null) iconLayout.size.width + 12.dp.toPx() else 0f
+            val wholeWidth = layout.size.width + iconSpace
+
+            // A word wider than the room is made to fit it.
+            val fit = (roomWidth * 0.92f / wholeWidth).coerceAtMost(1f)
+            val scale = scaleAt(place) * fit
+            val y = yAt(place)
+            val color = if (place > 0f) lerp(ink, KineticAccent, place.coerceIn(0f, 1f)) else ink
+
+            // A word that is moving is smeared up and down, a little.
+            val reach = smear * bigHeight * 0.16f
+            val ghosts = reach > 2f
+            val offsets = if (ghosts) floatArrayOf(-reach, 0f, reach) else floatArrayOf(0f)
+            val weight = if (ghosts) floatArrayOf(0.3f, 0.5f, 0.3f) else floatArrayOf(1f)
+
+            for (k in offsets.indices) {
+                val centre = Offset(centreX, y + offsets[k])
+                withTransform({ scale(scale, scale, centre) }) {
+                    val startX = centre.x - wholeWidth / 2f
+                    if (iconLayout != null) {
+                        drawText(
+                            iconLayout,
+                            topLeft = Offset(startX, centre.y - iconLayout.size.height / 2f),
+                            alpha = alpha * weight[k],
+                        )
+                    }
+                    drawText(
+                        layout,
+                        color = color.copy(alpha = color.alpha * alpha * weight[k]),
+                        topLeft = Offset(startX + iconSpace, centre.y - layout.size.height / 2f),
+                    )
+                }
+            }
+        }
+    }
+}
