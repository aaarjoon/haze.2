+import dev.lelonio.square.data.LyricLine
+import dev.lelonio.square.data.Lyrics
+import kotlin.math.abs
+
+/**
+ * How far ahead of the song's reported position a notification arrives, for
+ * the same reason a message does (see MessagesLyricsView).
+ */
+private const val ARRIVE_LEAD_MS = 150L
+
+/** How many cards show behind the newest while the stack is closed. */
+private const val BEHIND = 2
+
+/**
+ * The lyrics as notifications, the way a phone stacks them.
+ *
+ * Each part of the song arrives as a glass notification from this app: its
+ * icon, its name and "now" along the top and the lyric as the subject. The
+ * next one drops in over it with a little spring, and the one before slips
+ * back, leaving only its edge showing under the new one, like the pile of
+ * them on a lock screen.
+ *
+ * Touching the pile, or pulling on it, opens it out into a list of everything
+ * sung so far, newest first, which can be scrolled; a card pressed there
+ * seeks to its line, and "Show less" closes it again. While it is open, new
+ * lines still arrive at the top.
+ *
+ * Lyrics that are not synced have no "now" for a pile to follow, so they are
+ * shown plainly, as in the classic view.
+ */
+@Composable
+fun NotificationsLyricsView(
+    lyrics: Lyrics,
+    positionMs: State<Long>,
+    modifier: Modifier = Modifier,
+    showTranslation: Boolean = false,
+    onSeek: (Long) -> Unit,
+) {
+    if (!lyrics.synced) {
+        ClassicLyricsView(
+            lyrics = lyrics,
+            positionMs = positionMs,
+            modifier = modifier,
+            showTranslation = showTranslation,
+            onSeek = onSeek,
+        )
+    } else {
+        NotificationPile(lyrics, positionMs, modifier, showTranslation, onSeek)
+    }
+}
+
+@Composable
+private fun NotificationPile(
+    lyrics: Lyrics,
+    positionMs: State<Long>,
+    modifier: Modifier,
+    showTranslation: Boolean,
+    onSeek: (Long) -> Unit,
+) {
+    // Read as a derived value, so only a change of line recomposes this.
+    val activeLine by remember(lyrics) {
+        derivedStateOf {
+            lyrics.lines.indexOfLast { (it.startTimeMs ?: 0L) <= positionMs.value + ARRIVE_LEAD_MS }
+        }
+    }
+
+    // The lines sung so far that have words, newest first.
+    val shown = remember(lyrics, activeLine) {
+        (0..activeLine).filter { lyrics.lines[it].text.isNotBlank() }.asReversed()
+    }
+
+    val icon = rememberAppIcon()
+    val appName = stringResource(R.string.app_name)
+    var open by remember(lyrics) { mutableStateOf(false) }
+
+    if (shown.isEmpty()) return
+
+    if (open) {
+        OpenedPile(
+            lyrics = lyrics,
+            shown = shown,
+            icon = icon,
+            appName = appName,
+            showTranslation = showTranslation,
+            onSeek = onSeek,
+            onClose = { open = false },
+            modifier = modifier,
+        )
+    } else {
+        ClosedPile(
+            lyrics = lyrics,
+            shown = shown,
+            icon = icon,
+            appName = appName,
+            showTranslation = showTranslation,
+            onOpen = { open = true },
+            modifier = modifier,
+        )
+    }
+}
+
+/** The newest notification, with the edges of the ones before it showing behind. */
+@Composable
+private fun ClosedPile(
+    lyrics: Lyrics,
+    shown: List<Int>,
+    icon: ImageBitmap?,
+    appName: String,
+    showTranslation: Boolean,
+    onOpen: () -> Unit,
+    modifier: Modifier,
+) {
+    val ink = GlassInk
+    val newest = shown.first()
+    val behind = minOf(BEHIND, shown.size - 1)
+
+    Box(
+        modifier
+            .fillMaxSize()
+            .padding(start = 16.dp, end = 64.dp, top = 56.dp),
+        contentAlignment = Alignment.TopCenter,
+    ) {
+        Box(
+            Modifier
+                .fillMaxWidth()
+                .clickable(onClick = onOpen)
+                .pointerInput(Unit) {
+                    detectVerticalDragGestures { _, drag -> if (abs(drag) > 4f) onOpen() }
+                },
+        ) {
+            // The edges of the ones before, farthest first. They take the
+            // newest card's size, so each shows as a strip under it.
+            for (rank in behind downTo 1) {
+                val scale = 1f - 0.06f * rank
+                Box(
+                    Modifier
+                        .matchParentSize()
+                        .graphicsLayer {
+                            scaleX = scale
+                            scaleY = scale
+                            translationY = rank * 10.dp.toPx() + size.height * (1f - scale) / 2f
+                            alpha = 1f - 0.3f * rank
+                        }
+                        .glass(ink),
+                )
+            }
+
+            // The one that was newest a moment ago slips back under the new one.
+            if (shown.size > 1) {
+                key(shown[1]) {
+                    val slip = remember { Animatable(0f) }
+                    LaunchedEffect(Unit) { slip.animateTo(1f, tween(260)) }
+                    val line = lyrics.lines[shown[1]]
+                    NotificationCard(
+                        icon = icon,
+                        appName = appName,
+                        time = "now",
+                        text = line.text,
+                        translation = line.translation.takeIf { showTranslation && !it.isNullOrBlank() },
+                        modifier = Modifier
+                            .matchParentSize()
+                            .clip(RoundedCornerShape(26.dp))
+                            .graphicsLayer {
+                                val p = slip.value
+                                scaleX = 1f - 0.06f * p
+                                scaleY = 1f - 0.06f * p
+                                translationY = 10.dp.toPx() * p + size.height * 0.06f * p / 2f
+                                alpha = 1f - p
+                            },
+                    )
+                }
+            }
+
+            // The new one drops in over them.
+            key(newest) {
+                val arrive = remember { Animatable(0f) }
+                LaunchedEffect(Unit) {
+                    arrive.animateTo(1f, spring(dampingRatio = 0.62f, stiffness = Spring.StiffnessMedium))
+                }
+                val line = lyrics.lines[newest]
+                NotificationCard(
+                    icon = icon,
+                    appName = appName,
+                    time = "now",
+                    text = line.text,
+                    translation = line.translation.takeIf { showTranslation && !it.isNullOrBlank() },
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .graphicsLayer {
+                            val p = arrive.value
+                            translationY = -(1f - p) * 40.dp.toPx()
+                            alpha = p.coerceIn(0f, 1f)
+                            scaleX = 0.94f + 0.06f * p
+                            scaleY = 0.94f + 0.06f * p
+                        },
+                )
+            }
+        }
+    }
+}
+
+/** Everything sung so far as a list of notifications, newest first. */
+@Composable
+private fun OpenedPile(
+    lyrics: Lyrics,
+    shown: List<Int>,
+    icon: ImageBitmap?,
+    appName: String,
+    showTranslation: Boolean,
+    onSeek: (Long) -> Unit,
+    onClose: () -> Unit,
+    modifier: Modifier,
+) {
+    val ink = GlassInk
+    val listState = remember(lyrics) { LazyListState() }
+    val newest = shown.first()
+
+    // A new one arriving brings the list back to the top, unless the listener
+    // is reading further down.
+    LaunchedEffect(newest) {
+        if (!listState.isScrollInProgress && listState.firstVisibleItemIndex <= 1) {
+            listState.animateScrollToItem(0)
+        }
+    }
+
+    LazyColumn(
+        state = listState,
+        // The round buttons down the right of the screen keep to their own strip.
+        contentPadding = PaddingValues(start = 16.dp, end = 64.dp, top = 56.dp, bottom = 48.dp),
+        verticalArrangement = Arrangement.spacedBy(8.dp),
+        modifier = modifier.fillMaxSize(),
+    ) {
+        item(key = "close") {
+            Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.End) {
+                Text(
+                    stringResource(R.string.lyrics_notifications_show_less),
+                    style = MaterialTheme.typography.labelLarge,
+                    fontWeight = FontWeight.SemiBold,
+                    color = ink,
+                    modifier = Modifier
+                        .clip(RoundedCornerShape(50))
+                        .glass(ink, RoundedCornerShape(50))
+                        .clickable(onClick = onClose)
+                        .padding(horizontal = 14.dp, vertical = 7.dp),
+                )
+            }
+        }
+        items(shown, key = { it }) { index ->
+            val line: LyricLine = lyrics.lines[index]
+            NotificationCard(
+                icon = icon,
+                appName = appName,
+                time = if (index == newest) "now" else clock(line.startTimeMs ?: 0L),
+                text = line.text,
+                translation = line.translation.takeIf { showTranslation && !it.isNullOrBlank() },
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .animateItem()
+                    .clickable { line.startTimeMs?.let(onSeek) },
+            )
+        }
+    }
+}
+
+/** One glass notification: the app's icon and name, when, and the lyric as its subject. */
+@Composable
+private fun NotificationCard(
+    icon: ImageBitmap?,
+    appName: String,
+    time: String,
+    text: String,
+    translation: String?,
+    modifier: Modifier = Modifier,
+) {
+    val ink = GlassInk
+    Row(
+        modifier
+            .clip(RoundedCornerShape(26.dp))
+            .glass(ink)
+            .padding(horizontal = 14.dp, vertical = 12.dp),
+        horizontalArrangement = Arrangement.spacedBy(12.dp),
+    ) {
+        AppIcon(icon, ink)
+        Column(Modifier.weight(1f)) {
+            Row(verticalAlignment = Alignment.CenterVertically) {
+                Text(
+                    appName,
+                    style = MaterialTheme.typography.labelMedium,
+                    fontWeight = FontWeight.SemiBold,
+                    color = ink.copy(alpha = 0.7f),
+                    maxLines = 1,
+                    modifier = Modifier.weight(1f),
+                )
+                Text(
+                    time,
+                    style = MaterialTheme.typography.labelSmall,
+                    color = ink.copy(alpha = 0.55f),
+                    maxLines = 1,
+                )
+            }
+            Text(
+                text,
+                style = MaterialTheme.typography.titleMedium.copy(fontSize = 17.sp),
+                fontWeight = FontWeight.SemiBold,
+                color = ink,
+                modifier = Modifier.padding(top = 2.dp),
+            )
+            if (translation != null) {
+                Text(
+                    translation,
+                    style = MaterialTheme.typography.bodyMedium,
+                    color = ink.copy(alpha = 0.7f),
+                    modifier = Modifier.padding(top = 2.dp),
+                )
+            }
+        }
+    }
+}
+
+@Composable
+private fun AppIcon(icon: ImageBitmap?, ink: Color) {
+    val shape = RoundedCornerShape(10.dp)
+    if (icon != null) {
+        Image(
+            bitmap = icon,
+            contentDescription = null,
+            modifier = Modifier.size(38.dp).clip(shape),
+        )
+    } else {
+        Box(Modifier.size(38.dp).clip(shape).background(ink.copy(alpha = 0.2f)))
+    }
+}
+
+/**
+ * The look of a pane of glass over the player's backdrop: a film dark enough
+ * (or, in the light setting, light enough) for the words on it to be read
+ * whatever is behind, a faint tint of the app's ink and a thin edge.
+ */
+@Composable
+private fun Modifier.glass(
+    ink: Color,
+    shape: RoundedCornerShape = RoundedCornerShape(26.dp),
+): Modifier {
+    val darkBackdrop = ink.luminance() > 0.5f
+    val film = if (darkBackdrop) Color.Black.copy(alpha = 0.42f) else Color.White.copy(alpha = 0.6f)
+    return this
+        .background(film, shape)
+        .background(ink.copy(alpha = 0.08f), shape)
+        .border(1.dp, ink.copy(alpha = 0.2f), shape)
+}
+
+/** This app's own icon, drawn once at a size that is sharp at a notification's. */
+@Composable
+private fun rememberAppIcon(): ImageBitmap? {
+    val context = LocalContext.current
+    return remember(context) {
+        runCatching {
+            val drawable = context.packageManager.getApplicationIcon(context.packageName)
+            val side = 128
+            val bitmap = android.graphics.Bitmap.createBitmap(
+                side, side, android.graphics.Bitmap.Config.ARGB_8888,
+            )
+            drawable.setBounds(0, 0, side, side)
+            drawable.draw(android.graphics.Canvas(bitmap))
+            bitmap.asImageBitmap()
+        }.getOrNull()
+    }
+}
+
+/** A time in the song as m:ss. */
+private fun clock(ms: Long): String {
+    val seconds = (ms / 1000L).coerceAtLeast(0L)
+    return "${seconds / 60}:${(seconds % 60).toString().padStart(2, '0')}"
+}
